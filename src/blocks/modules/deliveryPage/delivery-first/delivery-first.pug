include ../../../components/breadcrumbs/breadcrumbs
include ../../deliveryPage/delivery-form/delivery-form

mixin delivery-first
    -
        const info_list = [
            {
                icon: 'ic-opt-6',
                desc: 'Цены без лишних надбавок',
            },
            {
                icon: 'ic-opt-5',
                desc: 'Предсказуемые сроки поставки',
            },
            {
                icon: 'ic-opt-4',
                desc: 'Полное сопровождение сделки менеджерами питомника',
            },

        ]
    section.sectionDeliveryFirst
        .container
            .sectionDeliveryFirst__block
                .sectionDeliveryFirst__block_left
                    +breadcrumbs([
                        {title: 'Доставка растений оптом'}
                    ])
                    .sectionDeliveryFirst__context
                        .sectionDeliveryFirst__title: h1 Доставка растений оптом
                        .sectionDeliveryFirst__text Более 20 лет занимаемся организацией поставок посадочного материала из европейских питомников
                        .sectionDeliveryFirst__info
                            .text Оформить заказ можно по телефону:
                                a(href='tel:+7 (926) 878-65-38') +7 (926) 878-65-38
                            .message
                                .ic-color-tg: a(href='#'): +bgimage('/img/icons/msgr-tg.svg')
                                .ic-color-max: a(href='https://max.ru/u/f9LHodD0cOIXK6ke_TJPwBi3mg70andJkzoR6n2ZY1HQT6LCFznPQ5nfTt4'): +bgimage('/img/icons/msgr-max.svg')
                    .sectionDeliveryFirst__content
                        each item in info_list
                            .item
                                +icon(item.icon)
                                .item__text= item.desc
                +delivery-form

