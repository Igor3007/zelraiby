include ../../stories-block/stories-block
include ../../../components/faq/faq

mixin payment-faq
    -
        const faqData = [
            {
                title: 'Оплата наличными или картой в питомнике',
                answer: 'Ваш комфорт — наш приоритет. Забрали заказ и убедились, что всё в порядке? Теперь можно легко рассчитаться! <br><br> Мы принимаем как наличный, так и безналичный расчёт. Не нужно заранее оформлять платежи или делиться банковскими данными на сайте. Оплатите ваши саженцы картой или наличными в момент, когда они уже у вас, — это самый безопасный и прозрачный подход.'
            },
            {
                title: 'Безналичным или банковским переводом',
                answer: 'Безналичным или банковским переводом'
            },
        ]
    section.sectionAboutUsFAQ
        .container
            .sectionAboutUsFAQ__title Как можно оплатить заказ
            .sectionAboutUsFAQ__text Наличный и безналичный расчёт — всё для вашего удобства!
            +faq(faqData)
