include ../../stories-block/stories-block
include ../../../components/faq/faq

mixin product-FAQ
    -
        const faqData = [
            {
                title: 'Что такое питомник «Зелёный рай»?',
                answer: 'Питомник «Зеленый рай» в Могилеве – крупнейший современный питомник хвойных и лиственных растений, образованный в 1996 году. «Зеленый рай» – это большое, правильно организованное хозяйство и просто чудесная ландшафтная зона. <br><br> Год за годом питомник набирает новые мощности. В настоящее время хозяйство расположено на 50 га земельных угодий. Из них 2,0 га занимают производственные орошаемые площади под контейнерное выращивание саженцев и 35 га занимают растения в грунте. Питомник растений оснащен современной технической базой.'
            },
            {
                title: 'Где можно купить саженцы для посадки в России и Беларуси?',
                answer: 'Доставка по городу бесплатна при заказе от 3000 рублей. В другие регионы стоимость доставки рассчитывается индивидуально.'
            },
            {
                title: 'Какой срок доставки?',
                answer: 'Доставка по Москве — 1-2 рабочих дня. В регионы — от 3 до 10 рабочих дней в зависимости от удаленности.'
            },
            {
                title: 'Можно ли вернуть товар?',
                answer: 'Да, в течение 14 дней с момента получения заказа вы можете вернуть товар надлежащего качества.'
            },
            {
                title: 'Какие способы оплаты доступны?',
                answer: 'Мы принимаем наличные, банковские карты (Visa, Mastercard, МИР), а также онлайн-платежи через СБП и электронные кошельки.'
            },
            {
                title: 'Есть ли гарантия на товары?',
                answer: 'На все товары предоставляется гарантия от 1 года. Гарантийные условия зависят от категории товара.'
            }
        ]
    section.sectionProductFAQ
        .container
            .sectionProductFAQ__title Растения и саженцы из питомника «Зелёный рай»
            .sectionProductFAQ__text Что вам стоит знать перед заказом
            +faq(faqData)
