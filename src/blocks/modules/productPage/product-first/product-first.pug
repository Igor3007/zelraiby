include ../product-slider/product-slider
include ../../productPage/product-formSize/product-formSize

mixin product-first
    -
        const productInfo = [
            {
                name: 'Декоративность хвои',
                text: 'Игольчатая от серебристо-серых до серебристо-зеленых оттенков. Зимой с пурпурно-голубым оттенком.',
            },
            {
                name: 'Высота',
                text: 'Игольчатая от серебристо-серых до серебристо-зеленых оттенков. Зимой с пурпурно-голубым оттенком.',
            },
            {
                name: 'Максимальная высота, см',
                text: '155',
            },
            {
                name: 'Зимостойкость',
                text: '-25°С',
            },
            {
                name: 'Использование',
                text: 'Высаживают на каменистых горках, рокариях, террасах, в композициях с кустарниками.',
            },
            {
                name: 'Болезни и вредители',
                text: 'Устойчив к болезням и вредителям.',
            },
            {
                name: 'Отношение к свету',
                text: 'Солнце, полутень.',
            },
            {
                name: 'Отношение к влаге',
                text: 'Умеренное.',
            },
            {
                name: 'Крона',
                text: 'Распростёртая, приподнятая, концы побегов живописно свисают.',
            },

        ]
    section.sectionProductFirst
        .container
            .sectionProductFirst__titleDoubleMD Саженцы можжевельника скального Блю Арроу
            +slider-product
            .sectionProductFirst__content
                a(href='#').sectionProductFirst__link
                    span Саженцы можжевельника
                    +icon('ic_arr_round')
                .sectionProductFirst__titleDouble Саженцы можжевельника скального Блю Арроу
                .sectionProductFirst__text.openBlock
                    p Жесткие, вертикально растущие, плотно прижатые к стволу побеги, прирастают примерно 15 см в год. В 10-летнем возрасте растение достигает 2-3 м в высоту и 0,5-0,7 м в диаметре. Хвоя ярко-голубая, мягкая, чешуйчатая. Плоды – сизовато-синие шишкоягоды. Дополнительным плюсом «Blue Arrow» является то, что нижние ветви растут почти от самого основания ствола и очень долгое время сохраняются.
                    .readMore.toggleBtn
                        span Читать далее
                        +icon('ic_arr-down')
                .sectionProductFirst__anchor
                    a(href='#id1').anchor
                        span Полное описание
                        +icon('ic_arr-down')
                    a(href='#id2').anchor
                        span Характеристики
                        +icon('ic_arr-down')

                .btn Отправить заявку

                +product-formSize

                #id1.sectionProductFirst__info
                    .sectionProductFirst__info_title Описание
                    .sectionProductFirst__info_text
                        p Жёсткие, вертикально растущие, плотно прижатые к стволу побеги, прирастают примерно 15 см в год. В 10-летнем возрасте растение достигает 2-3 м в высоту и 0,5-0,7 м в диаметре.
                        p Хвоя ярко-голубая, мягкая, чешуйчатая. Плоды — сизовато-синие шишкоягоды. Дополнительным плюсом «Blue Arrow» является то, что нижние ветви растут почти от самого основания ствола и очень долгое время сохраняются. Эта особенность дает неограниченные возможности в универсальном использовании сорта.
                        p Очень ценный сорт для создания небольших и масштабных ландшафтных композиций из хвойных и лиственных деревьев и кустарников с различной архитектурой и контрастной окраской листвы.
                #id2.sectionProductFirst__info
                    .sectionProductFirst__info_title Характеристики
                    each item in productInfo
                        .sectionProductFirst__info_item
                            .itemName= item.name
                            .itemText= item.text
