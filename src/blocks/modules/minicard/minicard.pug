mixin minicard(data)
    .minicard
        .minicard__image
            a(href=data.link)
                +picture(data.image)
        .minicard__main
            .minicard__name
                a(href=data.link)
                    .minicard__title= data.title
                    .minicard__btn
                        button.btn
                            +icon('ic_arrow')
            .minicard__price
                .minicard__price-current от #{data.priceCurrent}
                .minicard__price-old= data.priceOld
            .minicard__prop
                ul
                    li
                        small Размеры:
                        span= data.size
