mixin optom-size
    section.sectionOptomSize
        .container
            .sectionOptomSize__title Питомник «Зеленый рай» в цифрах
            .sectionOptomSize__text Крупнейший в Беларуси современный питомник хвойных и лиственных растений, образованный в 1996 году.
            .sectionOptomSize__content
                .item.itemText
                    .item__content
                        .item__title Более
                        .item__titleGreen 70 гектаров
                        .item__text земельных угодий
                    .item__content
                        .item__title От Р-9
                        .item__titleGreen до С-200
                        .item__text любые подходящие контейнеры
                .item: +picture('/img/catalogOpt/img-size-1')
                .item.hideTablet: +picture('/img/catalogOpt/img-size-2')
                .item.hideTablet: +picture('/img/catalogOpt/img-size-3')
                .item.hideTablet: +picture('/img/catalogOpt/img-size-4')
                .item.itemTwo: +picture('/img/catalogOpt/img-size-5')
                .item.itemText
                    .item__content
                        .item__title Более
                        .item__titleGreen 300 наименований
                        .item__text хвойных, лиственных и элитных растений
                    .item__content
                        .item__title Начиная
                        .item__titleGreen с 2014 года
                        .item__text предлагаем клиентам аллейные деревья и привитые формы
