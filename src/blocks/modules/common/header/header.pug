mixin headerMenuMob
    .MenuMobile
        .MenuMobile__header
            .MenuMobile__header_logo
                a(href='/'): +bgimage('/img/common/logo.svg')
            .btn.closeMenuMob: +icon('ic_close')
        .MenuMobile__main
            form(action='#' method='POST')
                .search-field
                    input(type="text" placeholder="Найти в каталоге...")
                    button.btn: +icon('ic_search')
            .MenuMobile__main_links
                .link
                    +icon('ic_cat_mini_03')
                    span Хвойные растения
                .link
                    +icon('ic_cat_mini_01')
                    span Лиственные деревья
                .link
                    +icon('ic_cat_mini_02')
                    span Декор. кустарники
            .MenuMobile__main_menu
                nav
                    ul
                        each item in mainMenu
                            li: a(href=item.link)= item.text


            .MenuMobile__main_contact
                .MenuMobile__main_contact-title: a(href='tel:+375 (29) 646-86-86') +375 (29) 646-86-86
                .MenuMobile__main_contact-sub C 8:00 до 17:00, ПН-ПТ

            .MenuMobile__main_contact
                .MenuMobile__main_contact-title: a(href='tel:+7 (926) 878-65-38') +7 (926) 878-65-38
                .MenuMobile__main_contact-sub: a(href='mailto:info-zelrai@tut.by') info-zelrai@tut.by

            .MenuMobile__main_msgr
                ul
                    li.ic-color-tg: a(href='#'): +bgimage('/img/icons/msgr-tg.svg')
                    li.ic-color-wa: a(href='#'): +bgimage('/img/icons/msgr-wa.svg')

mixin bottomNavigationMob
    .navigationMob
        .navigationMob__content
            a(href='#').navigationMob__item
                .navigationMob__item_icon: +icon('ic_telegram')
                .navigationMob__item_name Телеграм
            a(href='#').navigationMob__item
                .navigationMob__item_icon: +icon('ic_whatsapp')
                .navigationMob__item_name WhatsApp
            .navigationMob__item.openMenuMob
                .navigationMob__item_icon: +icon('ic_menu-search-dark')
                .navigationMob__item_name Меню
            a(href='/price.html').navigationMob__item
                .navigationMob__item_icon: +icon('ic_coins')
                .navigationMob__item_name Цены
            a(href='tel:+375 (29) 646-86-86').navigationMob__item
                .navigationMob__item_icon: +icon('ic_phoneMenu')
                .navigationMob__item_name Звонить

.container
    .header-top-fixed
        .header-top
            .header-top__logo
                a(href='/'): +bgimage('/img/common/logo.svg')
            .header-top__find
                button.btn.openMenu
                    +icon('ic_catalog')
                    span Каталог
                form(action='#' method='POST')
                    .search-field
                        input(type="text" placeholder="Найти в каталоге...")
                        button.btn: +icon('ic_search')
            .header-top__contact
                .header-contact
                    .header-contact__title: a(href='tel:+375 (29) 646-86-86') +375 (29) 646-86-86
                    .header-contact__sub C 8:00 до 17:00, ПН-ПТ

            .header-top__contact.header-top__contact--email
                .header-contact
                    .header-contact__title: a(href='tel:+7 (926) 878-65-38') +7 (926) 878-65-38
                    .header-contact__sub: a(href='mailto:info-zelrai@tut.by') info-zelrai@tut.by

            .header-top__msgr
                ul
                    li.ic-color-tg: a(href='#'): +bgimage('/img/icons/msgr-tg.svg')
                    li.ic-color-wa: a(href='#'): +bgimage('/img/icons/msgr-wa.svg')
                .btn.openMenuMob: +icon('ic_menu_dark')

        .header-nav
            .header-nav__catalog
                button.btn.openMenu
                    +icon('ic_catalog')
                    span Каталог
            .header-nav__menu
                nav
                    ul
                        each item in mainMenu
                            li: a(href=item.link)= item.text

        +headerMenuDesktop

    +headerMenuMob

+bottomNavigationMob

