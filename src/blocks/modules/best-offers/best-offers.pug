include ../minicard/minicard.pug

mixin  best-offers

    -
        const bestOffers = [
            {
                image: '/img/objects/img-0',
                title: 'Саженцы ели сербской Карел',
                link: 'product.html',
                priceCurrent: '120 руб.',
                priceOld: '140 руб',
                size: '1,20 ‒ 1,40 м',
                filterId: '1',
                id: '1'
            },
            {
                image: '/img/objects/img-1',
                title: 'Саженцы туи западной Брабант',
                link: 'product.html',
                priceCurrent: '120 руб.',
                priceOld: '140 руб',
                size: '1,20 ‒ 1,40 м',
                filterId: '1',
                id: '2'
            },
            {
                image: '/img/objects/img-2',
                title: 'Цветы гортензии древовидной Баунти',
                link: 'product.html',
                priceCurrent: '120 руб.',
                priceOld: '140 руб',
                size: '1,20 ‒ 1,40 м',
                filterId: '2',
                id: '13'
            },
            {
                image: '/img/objects/img-3',
                title: 'Цветы дерена белого Гушольти',
                link: 'product.html',
                priceCurrent: '120 руб.',
                priceOld: '140 руб',
                size: '1,20 ‒ 1,40 м',
                filterId: '3',
                id: '1342'
            },
            {
                image: '/img/objects/img-4',
                title: 'Саженцы ели обыкн. Купрессена ',
                link: 'product.html',
                priceCurrent: '120 руб.',
                priceOld: '140 руб',
                size: '1,20 ‒ 1,40 м',
                filterId: '3',
                id: '5431'
            },
            {
                image: '/img/objects/img-2',
                title: 'Цветы дерена белого Гушольти',
                link: 'product.html',
                priceCurrent: '120 руб.',
                priceOld: '140 руб',
                size: '1,20 ‒ 1,40 м',
                filterId: '2',
                id: '6571'
            },

        ]

    section.section-best-offers
        .container
            .best-offers
                .best-offers__title Великолепные растения из питомника
                .best-offers__tabs
                    ul
                        li(data-filter="0").is-active: span Все
                        li(data-filter="1"): span Хиты продаж
                        li(data-filter="2"): span Новинки
                        li(data-filter="3"): span Акции


                .best-offers__slider
                    .splide(data-slider="offers")
                        .splide__track
                            .splide__list.splide__list--offers
                                each item in bestOffers
                                    .splide__slide(data-filter-id=item.filterId)
                                        +minicard(item)
                .best-offers__bottom

                    .best-offers__action
                        a(href='#')
                            button.btn.btn-green
                                span Получить консультацию

                    .best-offers__select
                        a(href='#')
                            button.btn.btn-dark
                                span Выбрать растения
                                +icon('ic_leaf')


