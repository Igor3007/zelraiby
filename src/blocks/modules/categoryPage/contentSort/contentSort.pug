
mixin contentSort
    .contentSort
        .contentSort__title Сортировка
        .contentSort__select
            ul
                li.active(data-value="popular") По популярности
                li(data-value="price-asc") Сначала дешевле
                li(data-value="price-desc") Сначала дороже
                li(data-value="name-asc") По алфавиту (А-Я)
                li(data-value="name-desc") По алфавиту (Я-А)
