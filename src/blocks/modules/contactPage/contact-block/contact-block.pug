mixin contactCall
    .contactCall
        .contactCall__title: h2 Свяжитесь с нами
        .contactCall__line
            .item
                .item__name Телефоны в Беларуси:
                .item__info
                    a(href='tel:+7 (926) 878-65-38') +7 (926) 878-65-38
                    a(href='tel:+7 (926) 878-65-38') +7 (926) 878-65-38
            .item
                .item__name Телефон в России:
                .item__info
                    a(href='tel:+7 (926) 878-65-38') +7 (926) 878-65-38
            .item
                .item__name Мессенджеры:
                .item__infoMsgr
                    .ic-color-tg: a(href='#'): +bgimage('/img/icons/msgr-tg.svg')
                    .ic-color-wa: a(href='#'): +bgimage('/img/icons/msgr-wa.svg')
        .contactCall__line2
            .item
                .item__name Электронная почта:
                .item__info.mail
                    a(href='mailto:info-zelrai@tut.by') info-zelrai@tut.by
            .item
                .item__name Время работы:
                .item__info: p Работаем в будние дни с 8:00 до 17:00, в субботу и воскресенье — с 9:00 до 15:00.
        .contactCall__line3
            .item
                .item__name Адрес питомника:
                .item__info: p 212037, Беларусь, Могилёвский район, заезд с трассы Е95
            .item
                button.btn
                    span Построить маршрут
                    +icon('ic_map')


mixin contactMaps
    .contactMaps
        iframe.contacts__map-img(
            src="https://yandex.ru/map-widget/v1/?um=constructor%3A5c10949b76afc2d1ec3542d89966a0e6134c2e669aa60e4c5662b7d0582720f4&amp;source=constructor&z=12"
            frameborder="0"
            width="100%"
            height="100%"
            allowfullscreen="true"
            aria-label="Карта расположения"
            loading="lazy"
        )


mixin contact-block
    section.sectionContactBlock
        .container
            .sectionContactBlock__h1: h1 Контакты
            .sectionContactBlock__content
                +contactCall
                .sectionContactBlock__content_photo
                    span: +icon('ic_check_big')
                    +picture2('img-contactPage')
                +contactMaps

