mixin pagination()
    ul.pagination__page
        li.prev.control.disabled: span
            +icon('ic_chevron-left')
        li.active: a(href="#1") 1
        li: a(href="#2") 2
        li: a(href="#3") 3
        li: a(href="#4") 4
        li: span …
        li: a(href="#8") 8
        li.next.control: a(href="#2")
            +icon('ic_chevron-right')


mixin pagination-compact()
    ul.pagination__page.compact
        li.prev.control.disabled: span
            +icon('ic_chevron-left')
        li.active: a(href="#1") 1
        li: a(href="#2") 2
        li: a(href="#3") 3
        li: a(href="#4") 4
        li.next.control: a(href="#2")
            +icon('ic_chevron-right')


mixin pagination-showmore()
    .pagination
        ul.pagination__page
            li.active: a(href="#1") 1
            li: a(href="#2") 2
            li: a(href="#3") 3
            li: a(href="#4") 4

        a(href='#')
            button.btn
                span Показать ещё
                +icon('ic_arr_round-left')


